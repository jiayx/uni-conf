{
  "id": "quixotic",
  "name": "Quixotic",
  "repositoryUrl": "https://github.com/QuixoticHeart/rule-set",
  "branch": "ruleset",
  "defaultSourceId": "mihomo",
  "ignoredIds": ["fake-ip-filter"],
  "sources": [
    {
      "id": "mihomo",
      "path": "meta",
      "include": ["*.list"],
      "format": "mihomo",
      "behavior": "classical",
      "nativeFor": ["mihomo"]
    },
    {
      "id": "stash",
      "path": "stash",
      "include": ["*.list"],
      "format": "stash",
      "behavior": "classical",
      "nativeFor": ["stash"]
    },
    {
      "id": "singbox",
      "path": "singbox/version5",
      "include": ["*.srs"],
      "format": "singbox",
      "behavior": "classical",
      "nativeFor": ["singbox"]
    },
    {
      "id": "surge",
      "path": "surge",
      "include": ["*.list"],
      "format": "surge",
      "behavior": "classical",
      "nativeFor": ["surge"]
    },
    {
      "id": "loon",
      "path": "loon",
      "include": ["*.list"],
      "format": "loon",
      "behavior": "classical",
      "nativeFor": ["loon"]
    },
    {
      "id": "shadowrocket",
      "path": "shadowrocket",
      "include": ["*.list"],
      "format": "shadowrocket",
      "behavior": "classical",
      "nativeFor": ["shadowrocket"]
    },
    {
      "id": "quantumultx",
      "path": "quantumultx",
      "include": ["*.list"],
      "format": "quantumultx",
      "behavior": "classical",
      "nativeFor": ["quantumultx"]
    },
    {
      "id": "egern",
      "path": "egern",
      "include": ["*.yaml"],
      "format": "egern",
      "behavior": "classical",
      "nativeFor": ["egern"]
    },
    {
      "id": "custom",
      "repositoryUrl": "https://github.com/QuixoticHeart/rule-set",
      "branch": "master",
      "path": "custom",
      "include": ["*.list"],
      "format": "text",
      "behavior": "classical",
      "nativeFor": []
    }
  ],
  "defaults": {
    "category": "general",
    "provisioning": "optional",
    "sortOrder": 900,
    "activeForUnmatchedPolicies": ["proxy", "direct"]
  },
