{
  "name": "@uni-conf/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project worker",
    "test:coverage": "vitest run --project worker --coverage",
    "db:migrate": "wrangler d1 migrations apply DB",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:studio": "wrangler d1 studio DB"
  },
  "dependencies": {
    "@uni-conf/types": "workspace:*",
    "hono": "^4.12.25",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.25",
    "@cloudflare/workers-types": "^4.20260617.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.12.3",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "~6.0.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.101.0"
  }
}
