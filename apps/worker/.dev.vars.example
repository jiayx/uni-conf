# Copy this to .dev.vars and fill in values for local development
# .dev.vars is gitignored

ENVIRONMENT=development

# Optional in local development: set an API key to protect the admin API endpoints
# Leave empty to allow all requests in development
# In production, API_KEY is required and should be set with `wrangler secret put API_KEY`
API_KEY=

# Optional: restrict CORS to the deployed frontend origin
# Leave empty to allow all origins (fine for local development only)
ALLOWED_ORIGIN=
