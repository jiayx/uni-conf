{
  "name": "@uni-conf/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint src --type-aware --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
